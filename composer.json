{
    "name": "semitexa/locale",
    "description": "Semitexa Locale - translation, locale resolution, and i18n support for applications",
    "type": "semitexa-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.10.29.1052 || dev-master",
        "semitexa/orm": "*"
    },
    "suggest": {
        "semitexa/tenancy": "Required for TenantResolvedLocaleListener \u2014 sets locale from tenant context"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Locale\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Locale\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/core": "2026.10.29.1052"
            }
        }
    },
    "keywords": [
        "semitexa",
        "locale",
        "i18n",
        "translations",
        "localization"
    ]
}
